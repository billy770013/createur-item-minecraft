# Optional: copy to .env, then use:
# node --env-file=.env --import tsx src/server/index.ts
MCSTUDIO_PORT=5930

# Optional Linux Bedrock server integration. Match your own installation.
# MCSTUDIO_SERVER_ROOT=/opt/minecraft/mcbedrock
# MCSTUDIO_WORLD_NAME=MyWorld
# MCSTUDIO_SERVICE=mcbedrock
# MCSTUDIO_CONSOLE_FIFO=/opt/minecraft/mcbedrock/console.in

# Used by the Windows launcher when inherited from the environment.
# MCSTUDIO_URL=http://127.0.0.1:5930/
